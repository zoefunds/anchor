// Mirrors packages/types/index.ts — keep in sync.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CaseStatus {
  OPEN
  EVIDENCE_COLLECTION
  SUBMITTED
  ADJUDICATING
  ACCEPTED
  APPEAL_WINDOW
  APPEALED
  RE_ADJUDICATING
  FINALIZED
  UNDETERMINED
  CANCELLED
}

enum PartyRole {
  claimant
  respondent
}

// Real P1 fixed here (external audit finding): Evidence.submittedBy was
// previously the ONLY attribution signal, and for organization-
// authenticated routes it was just a caller-supplied string the org
// could set to "claimant" or "respondent" with zero verification —
// audited as "organization callers can self-assert party attribution."
// This enum is set server-side, never from request input, in every
// evidence route (see api/cases/:id/evidence*, api/public/cases/:id/
// evidence*) — it records HOW this row's attribution was actually
// established, independent of what submittedBy claims.
enum EvidenceAttributionSource {
  // Written by an org session/API-key caller — submittedBy (if set) is
  // the org's own unverified assertion about which party this is from.
  organization_asserted
  // Written by the public party-evidence route, resolved from a real
  // claimant token/session — see lib/party-auth.ts. Stronger than
  // organization_asserted (real party-specific standing), but still not
  // cryptographic proof unless signatureVerified is also true.
  claimant_authenticated
  respondent_authenticated
}

// An Organization is the tenant boundary: it owns API keys (for agent /
// programmatic callers) and has human Members (for dashboard logins).
// Every Case belongs to exactly one Organization — this is the scoping
// unit for both auth paths, so an org's cases are the same whether you're
// an agent calling with an API key or a human logged into the dashboard.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // External anchoring of this org's audit-log hash chain (see
  // lib/audit-anchor.ts and chains/evm/contracts/AuditAnchor.sol) —
  // tracks the last hash actually posted on-chain, so the periodic sweep
  // only submits a real transaction when the chain has genuinely grown
  // since the last anchor, not on every sweep tick regardless of change.
  lastAnchoredHash String?
  lastAnchoredAt   DateTime?
  lastAnchorTxHash String?

  // Phase 5 RBAC: requests/minute ceiling applied to every API key on
  // this org by checkApiKeyRateLimit (lib/auth.ts), replacing the old
  // hardcoded flat 120/min for everyone. Default matches that prior
  // flat value, so an org that never touches this field sees no
  // behavior change.
  apiRateLimitPerMinute Int @default(120)

  members                Member[]
  apiKeys                ApiKey[]
  cases                  Case[]
  invites                Invite[]
  webhooks               Webhook[]
  auditLogs              AuditLog[]
  settlementIntegrations SettlementIntegration[]
  policies               Policy[]
  incidents              Incident[]
}

// Phase 5, item C: manually-appended status-page incident history — no
// auto-detection, an operator creates/updates these directly (e.g. via
// psql or a future admin route). Deliberately minimal: title + status +
// timestamps + a short description, nothing that could leak case data.
enum IncidentStatus {
  INVESTIGATING
  MONITORING
  RESOLVED
}

model Incident {
  id             String         @id @default(cuid())
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  organizationId String?
  title          String
  description    String
  status         IncidentStatus @default(INVESTIGATING)
  startedAt      DateTime       @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([startedAt])
}

enum MemberRole {
  OWNER
  MEMBER
  // Read-only: can view cases, evidence, decisions, and the public case
  // pages, but every mutating dashboard action (create/adjudicate/appeal
  // a case, submit evidence, invite/remove members, manage API keys or
  // webhooks) is rejected - see requireWriteAccess() in lib/auth.ts.
  VIEWER
}

model Member {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  email           String       @unique
  passwordHash    String
  // The founding member (created via signup) is OWNER; everyone invited
  // afterward is MEMBER by default. OWNER-only actions: inviting/removing
  // members, managing webhooks, viewing the audit log.
  role            MemberRole   @default(OWNER)
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())

  sessions           Session[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  caseAccess         CaseAccess[]
}

// Single-use token proving control of the signup email. Verification is
// informational today (nothing is blocked on it yet) but the mechanism
// exists so gating (e.g. requiring it before inviting others) can be
// turned on later without another migration.
model EmailVerification {
  id         String    @id @default(cuid())
  member     Member    @relation(fields: [memberId], references: [id])
  memberId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([memberId])
}

// A webhook subscription for one org. The secret is AES-256-GCM
// encrypted at rest (see secretCiphertext/secretIv/secretAuthTag below)
// — this comment previously said "stored in cleartext," which was
// accurate before the encryption fix but stale and misleading
// afterward; caught while touching this file for an unrelated change.
model Webhook {
  id               String       @id @default(cuid())
  organization     Organization @relation(fields: [organizationId], references: [id])
  organizationId   String
  url              String
  // Real P1 fixed here (external audit finding, raised twice): the
  // signing secret used to be a single plaintext `secret` column,
  // returned in full on every GET. Now AES-256-GCM-encrypted at rest
  // (see lib/webhooks.ts's encryptWebhookSecret/decryptWebhookSecret) —
  // only secretPreview (a short masked prefix, same convention as
  // ApiKey.keyPrefix) is ever returned from a list/read; the raw secret
  // is shown once, at creation or rotation, and never again. Required
  // (not nullable) since
  // prisma/migrations/20260902200000_webhook_secrets_not_null —
  // confirmed every existing row was backfilled (production had zero
  // Webhook rows at the time) before that migration was applied; the
  // old plaintext `secret` column is gone.
  secretCiphertext String
  secretIv         String
  secretAuthTag    String
  secretPreview    String
  // Event names this webhook wants, e.g. "case.status_changed",
  // "case.decided". Enforced against a fixed vocabulary in application
  // code (src/lib/webhooks.ts), not the DB schema.
  events           String[]
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())

  deliveries WebhookDelivery[]

  @@index([organizationId])
}

// One delivery attempt, kept for debugging ("why didn't my webhook fire /
// what did you actually send") rather than for retries — delivery is
// best-effort fire-and-forget, matching the adjudication job's own
// reliability posture (see Job model for the one queue that DOES retry).
model WebhookDelivery {
  id             String   @id @default(cuid())
  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  webhookId      String
  event          String
  payload        Json
  responseStatus Int?
  error          String?
  createdAt      DateTime @default(now())

  @@index([webhookId])
}

// Append-only record of who did what. Written by application code at
// each mutating action, not derived from anything else — there's no
// reconstruction path if a write here is skipped, so callers must log
// before/alongside the mutation, not as a best-effort afterthought.
model AuditLog {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  // Exactly one of memberId/apiKeyId is set, identifying which auth path
  // performed the action - null/null would mean an unauthenticated action,
  // which should never happen since every mutating route requires auth.
  memberId       String?
  apiKeyId       String?
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  // Tamper-evidence: a per-organization hash chain (see lib/audit.ts).
  // prevHash is the previous row's own hash (a fixed genesis value for
  // the first row in each organization's chain); hash is sha256 of this
  // row's own fields concatenated with prevHash. Editing or deleting a
  // row, or reordering rows, breaks the chain from that point forward in
  // a way verifyAuditChain() can detect — this doesn't prevent someone
  // with direct DB write access from rewriting the whole chain (that
  // needs an external anchor, e.g. periodically publishing the latest
  // hash somewhere outside this database), but it does mean an
  // in-place edit of one historical row is detectable, which a bare
  // mutable table never was.
  prevHash       String
  hash           String       @unique

  @@index([organizationId])
  @@index([createdAt])
}

// Background job queueing (currently just adjudication runs) is handled
// by BullMQ on Redis now, not a table here — see src/lib/queue.ts,
// src/lib/worker.ts, and src/worker.ts (the standalone entrypoint). It
// used to be a DB-backed `Job` table with an in-process poller; that
// bought "survives a process restart" but not real retry backoff or a
// proper dead-letter queue, and nothing else in the app ever read the
// table directly, so it was dropped in favor of the real broker rather
// than kept as a second, now-redundant source of job state.

// An invite is how an org grows past its founding member — created by any
// existing member, redeemed once by setting a password, scoped to one
// email and one org so it can't be replayed against a different org.
model Invite {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  email          String
  // The role the invitee joins as once they accept — chosen by the
  // inviting owner at invite time (see api/invites POST), not
  // changeable afterward except by removing and re-inviting.
  role           MemberRole   @default(MEMBER)
  // SHA-256 of the raw invite token, same discipline as Session/ApiKey —
  // the raw token only ever lives in the emailed link.
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// Single-use, short-lived token for the "forgot password" flow. Requesting
// a reset never reveals whether the email exists (the API route always
// responds the same way); the token itself is what actually gates the
// password change.
model PasswordReset {
  id        String    @id @default(cuid())
  member    Member    @relation(fields: [memberId], references: [id])
  memberId  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId])
}

model Session {
  id        String   @id @default(cuid())
  member    Member   @relation(fields: [memberId], references: [id])
  memberId  String
  // SHA-256 of the raw session token — the raw token itself lives only in
  // the signed cookie, never stored, same discipline as the API key hash.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// API keys are for agent/programmatic callers (the primary integration
// path per the original AaaS positioning) — a raw key is shown exactly
// once at creation; only its hash and a display prefix are stored.
model ApiKey {
  id                  String       @id @default(cuid())
  organization        Organization @relation(fields: [organizationId], references: [id])
  organizationId      String
  name                String
  keyHash             String       @unique
  keyPrefix           String
  createdAt           DateTime     @default(now())
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  // Real P0-adjacent gap fixed here (external audit finding): API keys
  // had no creator, no expiry, and no case restriction at all — every
  // key was permanently valid and org-wide-unrestricted the moment it
  // was minted. Nullable because keys created before this migration
  // genuinely have no recorded creator — never backfilled with a
  // guess.
  creatorMemberId     String?
  // Nullable = never expires (an operator can still explicitly choose
  // this), but api-keys/route.ts now defaults new keys to a bounded
  // expiry rather than "forever" unless the caller opts out.
  expiresAt           DateTime?
  // Empty array (the default) = unrestricted, org-wide access — the
  // original, still-supported behavior. A non-empty array restricts
  // this key to exactly these case IDs, checked in case-access.ts
  // alongside the existing CaseAccess-for-members mechanism.
  restrictedToCaseIds String[]     @default([])
  // Phase 5 RBAC: empty array (the default) = full access to every
  // scope in lib/api-scopes.ts. This is a deliberate backward-compat
  // choice, not an oversight — every key minted before this column
  // existed has scopes=[] and must keep working exactly as before, so
  // "no scopes recorded" reads as "no restriction" rather than "no
  // access." A non-empty array is an allowlist of exactly those scopes,
  // enforced in lib/auth.ts's requireScope().
  scopes              String[]     @default([])
  // Which key this one replaced via the rotate endpoint, if any — purely
  // an audit trail, not consulted by any auth check.
  rotatedFromKeyId    String?
}

// Real P0 fix in progress (external audit finding, raised across every
// pass this session): the actual gap isn't just that EVM dispatch
// hardcoded escrowId to zero — it's that no contract implementing
// DecisionRelay.sol's own ISettlementTarget interface has ever been
// written or deployed. These two models are the data-model half of the
// fix, built first because they're safe to add now (purely additive,
// no financial risk) while the actual escrow smart contract — real
// money-holding code that deserves careful, unhurried design and
// Foundry test coverage, not something to rush — gets built as its own
// focused piece of work. NOT YET WIRED into dispatch logic; that
// requires the real contract to exist first, so validating against it
// would be untestable before then.
//
// SettlementIntegration: an org's one-time declaration of "this real,
// deployed escrow contract is one I trust for settlement on this
// chain" — the approved-integration record the audit asked for,
// replacing "any address the case-creation caller supplies."
model SettlementIntegration {
  id                    String       @id @default(cuid())
  organization          Organization @relation(fields: [organizationId], references: [id])
  organizationId        String
  chain                 String // "sepolia" | "solanatestnet" — same vocabulary as Case.settlementChain
  escrowContractAddress String
  assetSymbol           String
  assetDecimals         Int
  active                Boolean      @default(true)
  // Real gate, not yet enforced anywhere until this field exists: when
  // true, dispatchDecisionForCase refuses to settle a case under this
  // integration unless BOTH parties have an APPROVED PartyVerification
  // — see lib/settlement-kyc.ts. Defaults to false (no behavior change
  // for any existing integration) since requiring KYC is a real policy
  // decision an operator opts into per integration, not a global rule
  // — a demo/no-real-funds integration shouldn't force parties through
  // identity verification just to test the adjudication flow.
  requireKycApproval    Boolean      @default(false)
  // Priority 2 (settlement-readiness gaps): which real, on-chain escrow
  // ABI shape this contract actually has — detected once, at
  // registration, from the contract's OWN live behavior (the raw
  // eth_call return-data length of deposits()), never assumed from
  // which address happens to be configured. Immutable after creation —
  // an integration whose live contract's shape changes (a redeploy at
  // the same address is the realistic threat model, e.g. via
  // SELFDESTRUCT+CREATE2 or a proxy) must fail closed at every
  // subsequent read, not silently keep decoding with a stale ABI — see
  // lib/escrow-version.ts's verifyEscrowVersionUnchanged.
  escrowVersion         EscrowVersion @default(V1)
  createdByMemberId     String
  createdAt             DateTime     @default(now())

  caseSettlements CaseSettlement[]

  @@index([organizationId])
}

// CaseSettlement: the real, on-chain-verified per-case escrow binding —
// created only once a real deposit is confirmed on-chain (not at case
// creation, and not from caller-supplied claims). This is what
// dispatchDecisionForCase will be required to read and validate against
// before ever calling settle(), once the real contract exists — see
// this model's own escrowId/claimantAddress/respondentAddress/
// expectedAmountAtto fields, which mirror exactly what the future
// on-chain adapter must confirm still matches at dispatch time.
model CaseSettlement {
  id                 String                @id @default(cuid())
  case               Case                  @relation(fields: [caseId], references: [id])
  caseId             String                @unique
  integration        SettlementIntegration @relation(fields: [integrationId], references: [id])
  integrationId      String
  // The escrow contract's own identifier for this specific deposit —
  // derived deterministically from caseId (see lib/case-settlement.ts's
  // deriveEscrowId), never caller-chosen, so it can't be reused or
  // guessed across cases.
  escrowId           String
  // Real fix (Item C — CaseSettlement used to be created with both
  // addresses caller-supplied, i.e. staff typing in whatever address
  // was pasted to them, exactly the gap this closes): nullable until
  // each party sets their OWN address via the party-token-authenticated
  // /api/public/cases/:id/settlement-address route. A deposit is never
  // confirmed (see checkAndConfirmDeposit) until both are set.
  claimantAddress    String?
  claimantAddressSetAt DateTime?
  respondentAddress  String?
  respondentAddressSetAt DateTime?
  expectedAmountAtto String // atto-unit string, same discipline as lib/genlayer.ts's toAttoAmount
  // Security-audit fix (finding #2, 2026-09-04): the real on-chain
  // authorizeDeposit() call that must happen before Escrow.deposit()
  // will accept anything for this escrowId at all — see
  // lib/case-settlement.ts's authorizeDepositOnChain. V2 escrows only;
  // stays null for a V1 integration, which has no such function.
  depositAuthorizedAt     DateTime?
  depositAuthorizeTxHash  String?
  status             CaseSettlementStatus  @default(PENDING_DEPOSIT)
  depositTxHash      String?
  depositConfirmedAt DateTime?
  settledTxHash      String?
  settledAt          DateTime?
  createdAt          DateTime              @default(now())

  @@index([integrationId])
}

enum CaseSettlementStatus {
  PENDING_DEPOSIT
  DEPOSITED
  SETTLED
  // A dispatch was attempted but the on-chain escrow state no longer
  // matched what this record expected (wrong amount, wrong parties,
  // already settled, etc) — recorded rather than silently retried, so
  // a mismatch is visible or in the audit log, not just a swallowed error.
  MISMATCH_BLOCKED
}

model Case {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id])
  organizationId  String
  status          CaseStatus   @default(OPEN)
  claim           String
  amount          Decimal
  currency        String       @default("USD")
  policyId        String
  policyVersion   String
  claimantRef     String
  respondentRef   String
  // GenLayer contract address once deployed for this case
  contractAddress String?

  // Per-party capability tokens (sha256 hash stored, raw token only ever
  // shown once at case creation, same discipline as Session/ApiKey/Invite)
  // - what makes "the claimant submitted this evidence" or "the
  // respondent triggered this appeal" a claim backed by possessing a
  // real per-case, per-role secret, not just something a caller typed
  // into a submittedBy form field with zero verification (the previous
  // state - see api/cases/[id]/evidence/route.ts's history). Anyone
  // holding claimantTokenHash's raw token can act AS the claimant on
  // this specific case via /api/public/cases/:id/* routes, independent
  // of the org's own session/API-key auth - real party-specific standing,
  // not full identity/signature verification (see docs/party-auth
  // discussion for why that's a larger, separate piece of work).
  claimantTokenHash        String?   @unique
  respondentTokenHash      String?   @unique
  // Bounds how long a bearer token stays valid — a long-lived capability
  // secret that never expires is exactly the kind of thing that keeps
  // working after it leaks (browser history, referrer headers, a
  // forwarded screenshot, support tooling logs). Set on issue/reissue
  // (see party-auth.ts's PARTY_TOKEN_TTL_MS); resolvePartyToken treats an
  // expired token as invalid, same as a wrong one.
  claimantTokenExpiresAt   DateTime?
  respondentTokenExpiresAt DateTime?

  // Optional upgrade path on top of the bearer token above — see
  // lib/party-signing.ts. A hex-encoded Ed25519 public key; the
  // matching raw private key is generated at the same time as the
  // token, shown to the party exactly once, and never stored. A
  // submission signed with it and verified against this key is
  // materially stronger evidence of attribution than bearer-token
  // possession alone (see Evidence.signatureVerified) - a leaked
  // bearer token doesn't let anyone forge a new signed submission.
  // Optional: a party who never uses their signing key can still
  // submit evidence/appeals with the bearer token alone.
  claimantPublicKey   String?
  respondentPublicKey String?

  partySessions PartySession[]

  // Optional cross-chain settlement target. When settlementChain +
  // settlementContract are both set, a decision persisting for this case
  // automatically dispatches a DecisionRelay Hyperlane message to this
  // chain/contract (see src/lib/hyperlane.ts and
  // adjudication-service.ts) - a case with no settlement target just
  // stops at the decision, same as before this existed. Supported chains:
  // "sepolia" (EVM DecisionRelay.sol) and "solanatestnet"
  // (Sealevel decision-relay program) - see packages/hyperlane-relay's
  // HYPERLANE_MAILBOX/HYPERLANE_DOMAIN maps for what's actually wired.
  //
  // The three settlementSolana* fields are Sealevel-only: decision-relay's
  // handle() needs real on-chain Solana pubkeys (claimant/respondent) and
  // the escrow program id to CPI into escrow.settle() - Anchor's own
  // claimantRef/respondentRef are deliberately pseudonymous opaque
  // strings (see packages/types's privacy note) and can't double as
  // these. Required together when settlementChain is a Sealevel chain,
  // unused for "sepolia".
  settlementChain               String?
  settlementContract            String?
  settlementSolanaClaimant      String?
  settlementSolanaRespondent    String?
  settlementSolanaEscrowProgram String?
  // The on-chain escrow case_id (e.g. "CASE-RELAY-..."), independent of
  // this row's own cuid `id` - decision-relay's handle() derives the
  // escrow case PDA from whatever case_id string is in the dispatched
  // message, so it must match what escrow.initialize_case() was actually
  // called with, not Anchor's internal id. Required alongside the other
  // settlementSolana* fields when settlementChain is a Sealevel chain.
  settlementSolanaCaseId        String?

  // Per-case access control, on top of the org-wide role model
  // (OWNER/MEMBER/VIEWER). Defaults to false — every case is visible to
  // the whole org, exactly the pre-existing behavior, so this is opt-in
  // per case rather than a breaking change. When true, MEMBER/VIEWER
  // session callers can only see/act on this case if a CaseAccess row
  // grants them explicit access; OWNER and API-key callers always see
  // every case regardless (same full-trust posture those two already
  // have everywhere else - see requireWriteAccess()'s API-key carve-out
  // and OWNER's existing unrestricted-admin role). See lib/case-access.ts
  // for the actual enforcement.
  restricted Boolean      @default(false)
  caseAccess CaseAccess[]

  // Phase 1 reliability work: marks a case created by
  // scripts/testnet-canary.ts's synthetic end-to-end signing/settlement
  // probe. Never set by any real case-creation route. Lets the canary's
  // own cleanup step (and any future ops-console filtering) identify
  // and remove its synthetic rows without relying on a naming
  // convention on claimantRef/respondentRef alone.
  isCanary Boolean @default(false)

  // Real recovery path for a case GenLayer genuinely couldn't decide:
  // before this existed, UNDETERMINED was a dead end — POST
  // /api/cases/:id/adjudicate hard-requires EVIDENCE_COLLECTION, so a
  // stuck case's only way forward was the emergency-refund escape hatch
  // (100% to claimant, no real second verdict). Null means the one-time
  // reopen hasn't been used yet; set (by POST /api/cases/:id/reopen,
  // OWNER-only) the moment it is. Capped at exactly one use per case —
  // deliberately not a counter — so a case that goes UNDETERMINED a
  // second time after a real re-adjudication attempt still has to fall
  // back to emergency-refund rather than looping forever.
  reopenedFromUndeterminedAt DateTime?

  evidence   Evidence[]
  // One-to-many, not one-to-one: an appeal produces a fresh Decision
  // rather than overwriting the first, so the full history (original
  // verdict, then the appealed re-adjudication) stays queryable. The
  // dashboard/API always show the latest by createdAt.
  decisions  Decision[]
  settlement CaseSettlement?
  partyVerifications PartyVerification[]

  // Phase 4, item 1 (policy engine): the exact immutable PolicyVersion
  // this case was bound to at creation time — set once, in the same
  // transaction as case creation, and NEVER re-resolved. Every
  // downstream read (adjudication, risk gating, settlement dispatch,
  // receipts, analytics) must join through THIS field, not re-look-up
  // "whatever the org's Policy currently publishes" — editing a Policy
  // after this case exists creates a new PolicyVersion row and leaves
  // this pointer untouched, which is what makes editing non-retroactive.
  // Nullable only for cases created before this migration (unknown
  // policy binding) and for any case whose organization has never
  // published a Policy — see lib/policy-engine.ts's resolvePolicyForCaseCreation
  // for the fallback behavior in that case.
  policyVersionRecordId String?
  policyVersionRecord   PolicyVersion? @relation(fields: [policyVersionRecordId], references: [id])

  riskAssessment RiskAssessment?
  review         CaseReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([organizationId])
  @@index([policyVersionRecordId])
}

// One Didit KYC session per (case, party role) — a claimant or
// respondent can start a real identity-verification session before
// settlement is trusted to pay out to their address. Not yet gating
// anything (no route checks this before allowing settlement) — this is
// the tracking/record layer; making verification mandatory before a
// real payout is a separate, later decision.
model PartyVerification {
  id           String   @id @default(cuid())
  case         Case     @relation(fields: [caseId], references: [id])
  caseId       String
  role         PartyRole
  // Didit's own session identifier — used for GET /v3/session/{id}/decision/
  // backfill/reconciliation and to correlate inbound webhooks.
  sessionId    String   @unique
  status       PartyVerificationStatus @default(NOT_STARTED)
  // Raw decision payload from Didit's webhook/API (id_verifications[],
  // liveness_checks[], face_matches[] etc — see Didit's V3 contract).
  // Stored as-is rather than projected into typed columns since the
  // shape is Didit's, not ours, and the audit trail value is in having
  // the real payload, not a lossy summary of it.
  decision     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- KYC policy-gate track (lib/kyc/*) additions below ---
  // Which lib/kyc provider-adapter produced this row. Existing rows
  // predate this column and default to "didit" (the only provider that
  // has ever written a PartyVerification), so the default is not a
  // guess — it is this table's entire real history.
  provider           String    @default("didit")
  // A provider reference distinct from sessionId for adapters (e.g. a
  // future Persona inquiry-id) whose session identifier and stable
  // reference are different fields; null for Didit, which has only one.
  providerReference  String?
  // Bound immutably at verification time, mirroring Case.policyVersionRecordId:
  // once a party is verified against policy version N's rules
  // (jurisdiction/provider requirements), that verification stays valid
  // against version N even if the org later publishes version N+1 with
  // different KYC requirements — re-verification only happens if the
  // party's own status needs it, never retroactively because policy text
  // changed. Nullable because rows written before this column existed
  // have no such binding on record.
  policyVersion      PolicyVersion? @relation(fields: [policyVersionId], references: [id])
  policyVersionId    String?
  jurisdiction       String?
  expiresAt          DateTime?

  events PartyVerificationEvent[]

  @@index([caseId])
  @@index([policyVersionId])
  @@unique([caseId, role])
}

// Append-only lifecycle trail for one PartyVerification, same discipline
// as SignerLifecycleEvent (see lib/signer-lifecycle.ts's header comment
// for why an inferred-after-the-fact history is not good enough): a
// verification that bounced APPROVED -> IN_REVIEW -> APPROVED via two
// separate webhooks, versus one that was manually overridden, look
// identical from PartyVerification's current row alone.
model PartyVerificationEvent {
  id                  String            @id @default(cuid())
  partyVerification   PartyVerification @relation(fields: [partyVerificationId], references: [id])
  partyVerificationId String
  fromStatus          PartyVerificationStatus?
  toStatus            PartyVerificationStatus
  // "webhook" for a provider-driven transition, "manual_override" for an
  // operator action recorded via settings/kyc — see kyc-gate.ts's
  // recordManualOverride, the only writer of the latter.
  source              String
  reason              String?
  actingMemberId      String?
  createdAt           DateTime          @default(now())

  @@index([partyVerificationId])
}

// Replay-defense ledger for /api/kyc/webhook, the same purpose
// Webhook.secret's HMAC-over-timestamp serves for outbound deliveries
// (see lib/webhooks.ts's header comment) but for INBOUND provider
// webhooks: a (provider, dedupeKey) pair is accepted at most once, ever.
// Checked and inserted inside the same transaction that would otherwise
// transition a PartyVerification's status, so a replayed webhook can
// never cause a second transition even if the first one already
// happened outside any transaction lifetime this table could race with.
model KycWebhookDelivery {
  id         String   @id @default(cuid())
  provider   String
  dedupeKey  String
  receivedAt DateTime @default(now())

  @@unique([provider, dedupeKey])
}

enum PartyVerificationStatus {
  NOT_STARTED
  IN_PROGRESS
  APPROVED
  DECLINED
  IN_REVIEW
  ABANDONED
  EXPIRED
}

// The allow-list for a restricted Case (see Case.restricted). A row here
// means that specific member can see/act on that specific case even
// though it's restricted — irrelevant for unrestricted cases (everyone in
// the org already sees those) and irrelevant for OWNER/API-key callers
// (they bypass restriction entirely).
model CaseAccess {
  id        String   @id @default(cuid())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId  String
  createdAt DateTime @default(now())

  @@unique([caseId, memberId])
  @@index([caseId])
  @@index([memberId])
}

model Evidence {
  id                String                    @id @default(cuid())
  caseId            String
  case              Case                      @relation(fields: [caseId], references: [id])
  // Plain string, not an enum: which types are valid depends on the
  // case's policy (see src/lib/policies.ts) - enforced in application
  // code, not the DB schema, since the set of valid types now varies per
  // policy rather than being one fixed global list.
  type              String
  contentHash       String
  // For text evidence: the content itself. For file evidence: an
  // internal Cloudinary reference (not a fetchable URL by itself) - see
  // lib/storage.ts's resolveEvidenceUri, which resolves it into a
  // freshly signed URL on demand for whoever actually needs to fetch it
  // (GenLayer at adjudication time, the org/public dashboard at read
  // time), each with its own appropriate expiry.
  storageRef        String
  // True only if this row was submitted with a valid Ed25519 signature
  // (see lib/party-signing.ts) verified against the submitting party's
  // stored public key - materially stronger attribution than merely
  // having presented a valid bearer token/session, which stays the
  // default and still-sufficient path. False for every org-authenticated
  // submission and every party submission that didn't include a
  // signature.
  signatureVerified Boolean                   @default(false)
  // Null for inline text evidence. Set for uploaded files — lets the
  // contract (and the dashboard) tell an image it can visually interpret
  // apart from a PDF/other file it can only note the existence of.
  mimeType          String?
  fileSizeBytes     Int?
  // Caller-claimed party role — kept for organization-authenticated
  // routes as informational (still just an assertion), and set from
  // real resolved party auth on the public routes. Never trust this
  // alone for attribution strength; see attributionSource.
  submittedBy       PartyRole?
  // Server-derived, never caller-controlled — see
  // EvidenceAttributionSource's own doc comment above. Defaults to the
  // most conservative value (organization_asserted) purely so existing
  // rows backfill safely when this column is added — every write path
  // sets it explicitly going forward, this default is never relied on
  // by application code.
  attributionSource EvidenceAttributionSource @default(organization_asserted)
  // Real extracted text content for uploaded PDFs (see
  // api/cases/:id/evidence/upload/route.ts) - previously the contract
  // could only confirm a PDF's URL was reachable, never read what was
  // actually in it. When set, adjudication-service.ts sends THIS to the
  // contract instead of storageRef, so the policy prompt genuinely sees
  // the document's content rather than "[File evidence confirmed
  // accessible, content could not be machine-read]". Null for
  // non-PDF files (images go through the contract's own multimodal
  // path instead - see adjudicator.py's _resolve_evidence) and for
  // inline text evidence (storageRef already IS the content there).
  extractedText     String?
  createdAt         DateTime                  @default(now())

  @@index([caseId])
}

model Decision {
  id                   String    @id @default(cuid())
  caseId               String
  case                 Case      @relation(fields: [caseId], references: [id])
  policyId             String
  policyVersion        String
  outcome              String
  // Integer basis points (0-10000) as returned by the GenLayer contract —
  // NOT a float. See docs/decision-schema.md for why (GenVM calldata
  // encoding rejects native float). Convert to a 0-1 fraction only for
  // display/analytics, never re-derive a float and send it back to GenLayer.
  claimantShareBps     Int?
  respondentShareBps   Int?
  reasonCodes          String[]
  evidenceUsed         String[]
  consensus            String
  confidence           Float?
  // sha256 of the exact evidence_json calldata the contract adjudicated
  // against (the contract's own deterministic evidence_hash - see
  // adjudicator.py). This is an EVIDENCE-binding proof, not a proof of
  // the decision or of GenLayer finality itself - see the fields below
  // for those. Kept under its original name (used as the settlement
  // relay's on-chain proof field) rather than renamed, to avoid touching
  // every call site for a cosmetic rename.
  proofHash            String?
  // sha256 of the exact adjudicator.py source deployed for this decision
  // (see lib/adjudication-service.ts) - the policy engine's own
  // governance record. Two decisions under the same policyId/policyVersion
  // string can still have run different actual prompt/logic if the
  // contract file changed without a version bump; this hash makes that
  // detectable instead of only trusting the version string.
  contractCodeHash     String?
  // The real GenLayer transaction hash of the adjudicate()/appeal() call
  // that produced this decision - proof this decision actually happened
  // on GenLayer (independently checkable via `genlayer receipt
  // <txHash>`), not just data Anchor's backend asserts. Previously
  // discarded entirely - genlayer.runAdjudication()'s return value was
  // never captured.
  adjudicateTxHash     String?
  // sha256 of the canonical (sorted) evidenceUsed array - lets a verifier
  // confirm the exact set of evidence type/contentHash pairs this
  // decision was built from without needing evidenceUsed's raw array
  // representation to match byte-for-byte.
  evidenceManifestHash String?
  // sha256 of this decision's own canonical content (case/policy ids,
  // outcome, shares, reason codes, proofHash, contractCodeHash) - a
  // single fingerprint for "this exact decision," independent of the
  // database row id, that a verifier can recompute from the decision's
  // own visible fields and compare against what a settlement relay
  // actually carried.
  decisionHash         String?
  explanation          String?
  appealWindowClosesAt DateTime?
  createdAt            DateTime  @default(now())

  // Set once an auto-dispatched DecisionRelay message goes out for this
  // decision (see adjudication-service.ts) - null means either the case
  // has no settlement target configured, or dispatch hasn't run/failed
  // (see relayError).
  relayTxHash    String?
  relayMessageId String?
  // For Solana settlements ONLY: the Sepolia transaction hash of the
  // separate Hyperlane notification dispatch (Mailbox.dispatch() call),
  // distinct from both relayTxHash (the real Solana attested_settle
  // transaction that actually moved funds) and relayMessageId (the real
  // Hyperlane message ID emitted by that dispatch's Dispatch event) -
  // three genuinely different identifiers that a prior version of this
  // code collapsed into one (relayMessageId was wrongly set equal to
  // relayTxHash for Solana, since dispatchDecisionForCase's Solana
  // branch never captured the real Hyperlane dispatch's own return
  // value). Null for EVM settlements, where the Hyperlane-delivered
  // message IS the settlement transaction, so there is no separate
  // notification tx to record.
  relayNotificationTxHash String?
  relayError     String?
  // How many dispatch attempts have been made (the first attempt, inline
  // in runAdjudicationJob/finalizeExpiredAppealWindows, plus any retries
  // from retryFailedSettlements' periodic sweep). Capped there at
  // MAX_RELAY_ATTEMPTS - a FINALIZED decision whose relay keeps failing
  // needs a human to look at why, not an unbounded retry loop hammering
  // a permanently broken settlement target forever.
  relayAttempts  Int       @default(0)
  // A short-lived claim/lease: set atomically (via updateMany's WHERE
  // guard, not read-then-write) immediately before a dispatch attempt
  // starts, so a concurrent retry sweep can't also see relayTxHash=null
  // and fire a second dispatch for the same decision while the first is
  // still in flight. Cleared implicitly by relayTxHash being set on
  // success; a stale claim (older than RELAY_CLAIM_TTL_MS, see
  // adjudication-service.ts) is treated as an abandoned attempt and can
  // be reclaimed - this bounds, but doesn't eliminate, the double-send
  // window, since the real fix is destination-side idempotency keyed by
  // decisionHash.
  relayClaimedAt DateTime?

  // M-of-N attestor co-signing (see lib/hyperlane.ts's
  // InsufficientAttestorSignaturesError and docs/multisig-attestor-setup.md):
  // set when the backend's own ATTESTOR_PRIVATE_KEYS alone can't reach
  // attestorThreshold on DecisionRelay.sol, so dispatch is paused
  // pending an external attestor's signature over this exact hash
  // rather than failing outright. pendingAttestationHash is
  // deterministic from the decision's own content (see
  // computeDecisionAttestationHash) — recomputing it never changes once
  // set. pendingAttestationSignatures accumulates externally-submitted
  // signatures (via POST /api/internal/pending-attestations/[id]/sign)
  // until dispatchSettlementForDecision has enough to actually dispatch.
  pendingAttestationHash       String?
  pendingAttestationSignatures String[] @default([])

  // Solana equivalent of the two fields above — kept separate because
  // Solana's Ed25519 signatures aren't recoverable the way EVM's ECDSA
  // ones are: a stored entry must carry the SIGNER'S PUBLIC KEY
  // alongside its signature, not just the signature bytes. A re-audit
  // correctly flagged that the EVM co-signing workflow
  // (pendingAttestationHash/Signatures + POST
  // /api/internal/pending-attestations/[id]/sign) had no Solana
  // counterpart, meaning solana-settle.ts's submitAttestedSettle was
  // called with no externalAttestations and would always throw before
  // broadcasting for any real 2-of-2 Solana decision. See
  // lib/solana-settle.ts's InsufficientSolanaAttestationsError and
  // docs/multisig-attestor-setup.md's Solana section.
  //
  // pendingSolanaAttestationMessage is the exact hex-encoded message
  // bytes decisionAttestationMessage() produces for this decision —
  // deterministic from the decision's own content, recomputing it never
  // changes once set. pendingSolanaAttestations accumulates
  // externally-submitted {publicKey, signature} pairs (base58/hex, via
  // POST /api/internal/pending-solana-attestations/[id]/sign) as a JSON
  // array until enough are collected to actually dispatch.
  pendingSolanaAttestationMessage String?
  pendingSolanaAttestations       Json?   @default("[]")

  // Real bug found 2026-09-13 (during the controlled-rehearsal
  // acceptance test): attestedSettle()'s signed digest now includes a
  // deadline (a real audit fix, closing a genuine "signature valid
  // forever" gap) — but dispatchDecisionForCase used to compute a fresh
  // `Date.now() + 30min` deadline on EVERY call, including retries.
  // Since deadline is part of the signed content, every retry produced
  // a DIFFERENT attestation hash, so signatures collected against an
  // earlier retry's hash could never combine with a later retry's
  // signature to reach threshold — real 2-of-3 quorum was structurally
  // unreachable across more than one poll cycle. This field persists
  // the FIRST deadline chosen for a decision's direct-settle attestation
  // so every retry (InsufficientAttestorSignaturesError and all) signs
  // and re-signs the exact same hash until either quorum is reached or
  // the deadline itself expires (at which point a fresh one is chosen
  // and this resets) — see dispatchSettlementForDecision's own use of
  // this field. Unix seconds, string (same atto-string discipline as
  // this schema's amount fields), not a Prisma BigInt column.
  directSettleDeadline String?

  // Controlled-rehearsal authorization (2026-09-13 remediation plan,
  // item 3): the ONLY way dispatchSettlementForDecision's real
  // SETTLEMENT_PAUSED check can ever be bypassed — and even then, only
  // for THIS specific decision, never globally. Set by a human operator
  // via scripts/rehearse-controlled-settlement.ts's --authorize step
  // (never by application code, never by an HTTP route), consumed
  // (testRehearsalConsumedAt set) atomically the moment a real dispatch
  // for this decision actually succeeds — not on every bypass attempt,
  // since gathering attestor signatures can legitimately take several
  // retries of the same one authorized action. Once consumed, this
  // token can never authorize anything again; a further rehearsal on
  // any case requires a fresh --authorize run ("re-arming"). Deliberately
  // decision-scoped (not case-scoped): a case with multiple decisions
  // (e.g. after an appeal) needs a fresh authorization per decision.
  testRehearsalAuthToken    String?   @unique
  testRehearsalConsumedAt   DateTime?

  @@index([caseId])
}

// Phase 1 reliability work: the signer/settlement lifecycle a Decision's
// automated settlement path moves through, tracked as an explicit,
// queryable state machine rather than only being inferable after the
// fact from Decision.relayError/relayTxHash. Distinct states matter
// because "one signer down" (still SIGNING, quorum not yet reached) and
// "two signers down" (stuck in SIGNING indefinitely — a human-visible
// pending-quorum state) look identical if all that's recorded is
// pass/fail; a dashboard or alert built only on relayTxHash-is-null
// can't tell those apart.
// Track 5, item 3: immutable, auditable metering. Append-only by
// convention (same as SignerLifecycleEvent) — no update/delete path is
// exposed anywhere in application code. This is metering
// infrastructure only; nothing in this repo reads BillableEvent to
// actually charge anyone (see lib/billing.ts's STUB_NOT_INVOICED
// status, which still derives from usage.ts's live counts, not this
// table — the two are intentionally independent so a future real
// invoicing system has a real, replayable event ledger to switch to
// without also needing computeStubInvoice's aggregate counts to be
// perfectly reconciled with it on day one).
model BillableEvent {
  id             String            @id @default(cuid())
  organizationId String
  eventType      BillableEventType
  // The entity this event is about — a caseId, decisionId, evidenceId,
  // apiKeyId, or settlementId depending on eventType. Not a foreign key
  // on purpose: this ledger must remain append-only and readable even
  // if the referenced row is later deleted or belongs to a table this
  // model shouldn't take a hard dependency on.
  subjectId      String
  // Free-form metering detail: for EVIDENCE_STORAGE_MB, the byte size;
  // for API_CALL, the route/method; for the rest, usually empty. Never
  // a pricing decision — quantity/pricing derivation stays in
  // billing.ts, kept separate from this raw event fact.
  quantity       Float?
  metadata       Json?
  createdAt      DateTime          @default(now())

  @@index([organizationId, eventType, createdAt])
  @@index([subjectId])
}

enum BillableEventType {
  CASE_OPENED
  ADJUDICATION_RUN
  EVIDENCE_STORAGE_MB
  API_CALL
  SETTLEMENT_COMPLETED
}

enum SignerLifecycleState {
  SIGNING
  QUORUM_REACHED
  DISPATCHED
  DELIVERED
  SETTLED
  FAILED
  ESCALATED
}

// Append-only — never updated or deleted (except by the canary's own
// cleanup of its synthetic decisionId rows) — one row per lifecycle
// transition. This is the durable trail "which signer signed, when,
// and what happened" that a startup-check failure, a stuck 1-of-3
// quorum, or an ops console needs, without ever persisting private key
// material (signerAddress is a public EVM address or Solana base58
// pubkey — never a key or raw signature).
model SignerLifecycleEvent {
  id            String               @id @default(cuid())
  decisionId    String
  // "sepolia" | "solanatestnet" — same vocabulary as Case.settlementChain.
  chain         String
  state         SignerLifecycleState
  signerAddress String?
  // Free-form context for FAILED/ESCALATED (the exact relayError or
  // exception message) and for SIGNING/QUORUM_REACHED (collected vs.
  // required signature counts) — never a private key, signature byte
  // string, or other secret material.
  reason        String?
  createdAt     DateTime             @default(now())

  @@index([decisionId])
  @@index([chain, state])
}

// Phase 3 ops console: testnet-canary.ts's synthetic Case/Decision rows
// are deleted in a `finally` block on every run (see its own doc
// comment) so a crashed run never leaves stale isCanary data behind —
// but that means nothing durable survives a SUCCESSFUL run either,
// leaving "when did the canary last succeed" answerable only by
// grepping process logs. This is the minimal persisted fact that makes
// it a real, queryable dashboard fact instead: one row per run,
// independent of whether its synthetic Case/Decision still exist.
model CanaryRun {
  id          String   @id @default(cuid())
  runId       String   @unique
  chain       String
  outcome     String // "settled" | "sla_breach" | "error"
  durationMs  Int
  relayTxHash String?
  detail      String?
  createdAt   DateTime @default(now())

  @@index([chain, createdAt])
}

// A short-lived exchange session for a party token — see
// party-auth.ts's exchangePartyTokenForSession. The long-lived bearer
// token (in claimantTokenHash/respondentTokenHash) is only ever meant
// to be used ONCE, to mint one of these; every subsequent request from
// that browser uses the session cookie instead, so the raw token stops
// appearing in URLs/query params (and therefore browser history,
// referrer headers, access logs, screenshots) after the first click.
// Same tokenHash-not-raw-token discipline as Session/ApiKey.
model PartySession {
  id        String   @id @default(cuid())
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    String
  role      String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([caseId])
}

// Single-row guard checked at job-worker startup (see lib/app-env.ts) —
// binds "this database" to a specific APP_ENV value so a worker process
// with a misconfigured/wrong APP_ENV can't silently consume jobs from a
// shared Redis queue while reading/writing the wrong database. id is
// always the literal string "singleton"; there is exactly one row.
model DeploymentEnvironment {
  id  String @id
  env String
}

// Item F — the reconciliation sweep's own durable state (see
// lib/reconciliation.ts). A finding is opened the first time a real
// check detects a real problem, and resolved the first time that same
// check no longer reproduces it — this is what makes the ops alert
// wired to it "fire once when something's actually wrong, once again
// when it's actually fixed," not a re-alert every 15-minute sweep tick
// for as long as a condition persists.
enum ReconciliationFindingType {
  // DecisionRelay.settlementTarget(domain) reads the zero address for
  // a domain that has at least one active SettlementIntegration — the
  // exact class of misconfiguration this project's own real
  // settlement-availability incident was.
  ZERO_SETTLEMENT_TARGET
  // DecisionRelay.settlementTarget(domain) is set, but to an address
  // that doesn't match the active SettlementIntegration's own
  // escrowContractAddress for that domain/case.
  TARGET_INTEGRATION_MISMATCH
  // A CaseSettlement has sat in PENDING_DEPOSIT, with both party
  // addresses already set, for longer than the sweep's overdue
  // threshold — a deposit that should have arrived hasn't.
  OVERDUE_DEPOSIT
  // DecisionRelay.processedDecisions(proofHash) reads true on-chain
  // for a dispatched Decision, but the linked CaseSettlement's own
  // status hasn't caught up to DEPOSITED/SETTLED — the DB has drifted
  // from chain state (this exact drift was found and hand-corrected
  // once already this session — see the incident log's "re-audit
  // response" section). The sweep both raises this finding AND
  // self-heals the DB record, same as a human operator did manually.
  DISPATCHED_BUT_DB_STALE
  // Organization.lastAnchoredAt is null or older than expected given
  // the audit-anchor sweep's own interval — the external anchoring
  // job appears to have stopped running silently.
  AUDIT_ANCHOR_STALE
  // Priority 2: an escrow contract's live, on-chain ABI shape (probed
  // via deposits()'s raw return-data length) no longer matches the
  // escrowVersion recorded at registration — the real threat model is
  // a redeploy at the same address (SELFDESTRUCT+CREATE2 or a proxy),
  // not a benign event. Fails closed: every read this catches refuses
  // to decode with a possibly-wrong ABI rather than guessing.
  ESCROW_VERSION_MISMATCH
  // Phase 1 reliability work: a Decision's relayAttempts hit
  // MAX_RELAY_ATTEMPTS (see adjudication-service.ts) without ever
  // reaching relayTxHash — the bounded-retry ceiling was real and was
  // hit, so this is a human-needed case, not a transient blip the next
  // sweep tick will quietly clear.
  RELAY_RETRIES_EXHAUSTED
  // The periodic testnet canary (scripts/testnet-canary.ts) took longer
  // than its configured SLA to complete signing+settlement+delivery for
  // its synthetic decision, or failed outright — a live, continuously
  // re-verified signal that the automated path is broken, independent
  // of whether any real case happens to be flowing through it right now.
  CANARY_SLA_BREACH
  // Phase 3 ops console: a Decision has sat with pendingAttestationHash
  // or pendingSolanaAttestationMessage set (co-signing has started) but
  // never reached relayTxHash for longer than the sweep's stale-signing
  // threshold — the operator-visible surface of "one signer down" (still
  // short of quorum) or "no signer responding at all" that
  // SignerLifecycleEvent's SIGNING state alone doesn't page anyone about.
  STALE_PENDING_SIGNATURE
  // A dispatched Decision (relayTxHash set, an EVM->Solana settlement
  // whose Hyperlane message is DecisionRelay's own processedDecisions
  // flag) never reached the DELIVERED SignerLifecycleEvent state within
  // the configured SLA — the Hyperlane relayer/validator path appears
  // stuck between dispatch and destination-side processing.
  LATE_HYPERLANE_DELIVERY
  // Billable adjudication/settlement records reference a Decision id
  // that no longer exists in the primary Decision table. That means
  // public verification and case history are incomplete even though the
  // append-only billing ledger proves the decision happened.
  MISSING_DECISION_RECORD
  // Live-read DecisionRelay.owner() / attestorThreshold no longer match
  // the committed deployment-manifest.json's expected values — the
  // deployed contract's governance configuration changed since the
  // manifest was last regenerated (scripts/generate-deployment-manifest.ts),
  // independent of whether that change was itself authorized.
  GOVERNANCE_DRIFT
  // Incident recovery Phase G.5 (2026-09-13 Sepolia delivery incident):
  // a deposit is sitting in a retired escrow's onlyDecisionRelay-gated
  // emergencyRefund() window — not stuck forever, but not recoverable
  // through the normal settlement path either (the DecisionRelay it's
  // bound to is retired/unreachable). Raised once activity enters the
  // alert window before the on-chain eligibility timestamp, so an
  // operator has real advance notice rather than discovering it only
  // once the timeout has already passed. detail carries the exact
  // escrow address, escrowId, claimant, amount, deposit tx, and the
  // on-chain readyAt timestamp — see docs/incidents/ for the full
  // recovery procedure this was raised against.
  OLD_ESCROW_REFUND_ELIGIBLE_SOON
}

// Priority 2: the real, on-chain ABI shapes actually deployed. V1 is
// the currently-live production shape (4-field deposits(), no caseId
// stored — see chains/evm/contracts/legacy/EscrowV1.sol). V2 is
// Escrow.sol's current source (6-field: adds caseId, then Item E added
// depositedAt) — not yet deployed anywhere, but real integrations will
// be registered against it once it is.
enum EscrowVersion {
  V1
  V2
  // The Sealevel (Solana) reference escrow program
  // (chains/solana/programs/escrow) — a single fixed Anchor-framework
  // account layout, not versioned the way the EVM contracts are (no
  // deposits()-return-length probe applies; verification instead reads
  // decision-relay's own storage PDA and the escrow's Case PDA
  // directly — see lib/solana-escrow.ts). Kept as its own enum value,
  // not reused "V1", so nothing ever assumes EVM ABI shape for a
  // Solana integration by name confusion.
  SOLANA_V1
}

model ReconciliationFinding {
  id         String                     @id @default(cuid())
  type       ReconciliationFindingType
  targetType String
  targetId   String
  detail     Json
  openedAt   DateTime                   @default(now())
  resolvedAt DateTime?
  // Set when the "finding opened" alert was actually sent — lets the
  // sweep tell "never alerted yet" apart from "alerted, still open,
  // don't re-alert every tick" without needing a separate table.
  alertedAt  DateTime?
  // Priority 5 (settlement-readiness gaps, item 18): a human
  // explicitly saying "I've seen this and I'm on it" — distinct from
  // resolvedAt, which only the sweep itself sets once the underlying
  // condition is actually gone. An unacknowledged critical finding is
  // exactly what an ops dashboard needs to make visible; acknowledging
  // it doesn't change the finding's own state, only records that a
  // real person has taken ownership.
  acknowledgedAt         DateTime?
  acknowledgedByMemberId String?
  // Real auto-escalation (settlement-readiness gaps status report,
  // "no auto-escalation" gap): a critical finding that's been alerted
  // but sits unacknowledged past a threshold gets a repeated,
  // distinctly-labeled escalation alert on its own cadence — separate
  // from alertedAt, which only ever fires once per opened finding.
  // Null means never escalated yet.
  lastEscalatedAt DateTime?

  events ReconciliationFindingEvent[]

  @@unique([type, targetId])
  @@index([resolvedAt])
}

// Priority 5, item 18: remediation history — every acknowledgement and
// operator note against a finding, in order, so "what did we do about
// this and when" is a real, queryable record rather than living only
// in Slack scrollback.
enum ReconciliationFindingEventType {
  ACKNOWLEDGED
  NOTE
}

// Re-audit response (Phase 1, item 3): a durable, queryable record of
// every real reliability observation — checkpoint currency, delivery,
// relayer/ISM/trustedSender wiring, validator independence — so a real
// 30-day reliability window has actual accumulated evidence behind it,
// not just markdown log snapshots written by hand (see
// chains/hyperlane-validator/24H_OBSERVATION_LOG.md's history, which
// this supersedes going forward). One row per sweep tick.
model ReliabilityObservation {
  id           String   @id @default(cuid())
  capturedAt   DateTime @default(now())
  // Raw checks array from verify-deployment.ts --json, unmodified —
  // the durable source of truth. passCount/warnCount/failCount below
  // are derived from this at write time purely so the dashboard/alert
  // logic doesn't need to re-parse it for a simple trend query.
  checks       Json
  // Re-audit hardening pass (2026-09-05): raw per-call RPC
  // method/latency/success stats for this sweep tick — real evidence
  // for "RPC request success/error/latency by method", not inferred
  // from check pass/fail alone.
  rpcStats     Json?
  // Deterministic HEALTHY/DEGRADED/DELIVERY_BLOCKED/UNKNOWN — see
  // reliability-monitor.ts's computeState. No inferred "probably okay"
  // state is allowed; settlement eligibility should only ever consult
  // this column, never re-derive its own looser interpretation.
  state        String   @default("UNKNOWN")
  passCount    Int
  warnCount    Int
  failCount    Int
  // Extracted from the checkpoint-currency check details when present
  // (the real number verify-deployment.ts already computes) — kept as
  // its own column so a lag trend can be queried/plotted without
  // parsing every row's raw JSON.
  maxCheckpointLagLeaves Int?
  // The script's own process exit code (0 = no fail-level checks).
  // Distinct from failCount === 0 only if the script itself crashed —
  // see runReliabilityObservation's own crash-handling.
  scriptCrashed Boolean @default(false)
  crashDetail   String?

  @@index([capturedAt])
}

// TRACK 1 (evidence-collection / external-proof readiness), item 1: the
// broad, whole-system 30-day reliability window — deliberately a
// SEPARATE model from ReliabilityObservation above, which only ever
// covered the Hyperlane checkpoint/delivery/wiring surface. This one
// composes system-health.ts (DB/Redis/EVM RPC/Solana RPC), the latest
// CanaryRun, SignerLifecycleEvent quorum state, and open
// ReconciliationFinding rows into one per-tick pass/fail verdict — see
// docs/reliability-observation-window.md for the exact written
// pass/fail and window-extension/reset rule this is scored against.
// One row per observation tick (15 minutes — see that doc for why).
model ReliabilityWindowObservation {
  id         String   @id @default(cuid())
  capturedAt DateTime @default(now())
  // Per-component ok/error snapshot: { db, redis, genlayer, evmRpc,
  // solanaRpc, signerQuorum, relayer, hyperlane, canary, reconciliation }
  // — see reliability-window.ts's ComponentSnapshot type for the exact
  // shape. Raw, not summarized, so a reviewer can verify the verdict
  // below independently.
  components Json
  // PASS or FAIL per docs/reliability-observation-window.md's written
  // rule — never re-derived looser than that doc at query time.
  status     String
  // Machine-readable reasons this tick is FAIL (empty array on PASS) —
  // e.g. "signer_quorum_loss", "missed_observation", "canary_failed",
  // "unresolved_reconciliation_finding", "unacknowledged_critical_finding".
  failReasons String[]
  notes       String?
  remediation String?
  // SHA-256 of this row's canonical JSON (id excluded, since the hash
  // is computed before the row has an id) — an honest, low-tech stand-in
  // for real PKI signing, matching manifest-signature.ts's precedent.
  // Anyone with DB read access can recompute and verify it; this is NOT
  // a claim of tamper-evidence against someone with write access to the
  // database itself.
  observationHash String

  @@index([capturedAt])
}

model ReconciliationFindingEvent {
  id         String                          @id @default(cuid())
  finding    ReconciliationFinding           @relation(fields: [findingId], references: [id])
  findingId  String
  type       ReconciliationFindingEventType
  memberId   String
  note       String?
  createdAt  DateTime                        @default(now())

  @@index([findingId])
}

// ============================================================
// Phase 4, item 1 — configurable, versioned policy engine.
//
// Policy is the organization-scoped, mutable "named slot" (e.g. "US
// consumer disputes") — it has no behavior of its own. PolicyVersion is
// the actual immutable, published configuration; "editing a policy"
// means publishing a new PolicyVersion row under the same Policy, never
// mutating an existing version's fields. A Case binds to exactly one
// PolicyVersion at creation time (see Case.policyVersionRecordId) and
// that binding never moves, even after a newer version is published —
// this is what "never let editing a policy retroactively change a live
// case" means concretely: there is no code path that re-resolves
// "current policy" for an existing case.
// ============================================================

model Policy {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  // Stable machine key within the org (e.g. "default", "us-consumer") —
  // distinct from a PolicyVersion's own auto-incrementing integer
  // version number.
  key            String
  name           String
  createdAt      DateTime     @default(now())

  versions PolicyVersion[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

// One immutable, published configuration snapshot. `version` is a
// simple per-Policy incrementing integer (1, 2, 3, ...) — publishing
// never edits an existing row, it inserts a new one with version+1 and
// flips `active` on the old row to false via publishPolicyVersion (see
// lib/policy-engine.ts). Rows here are never updated after creation
// except for the single `active` boolean, which only affects which
// version NEW cases bind to — it has zero effect on any case that
// already bound to an earlier version's id.
model PolicyVersion {
  id                    String   @id @default(cuid())
  policy                Policy   @relation(fields: [policyId], references: [id])
  policyId              String
  version               Int
  active                Boolean  @default(true)
  publishedAt           DateTime @default(now())
  publishedByMemberId   String?

  // --- The actual configuration surface (Phase 4 acceptance list) ---
  evidenceDeadlineHours Int
  appealWindowHours     Int
  allowedOutcomes       String[]
  // Cap expressed in the CASE'S OWN settlement currency (ETH or SOL —
  // whatever Case.currency actually is), never USD: Anchor settles only
  // native chain assets, and a USD-denominated cap made every real case
  // permanently ineligible for automated attestor signing (real bug
  // found and fixed 2026-09-12 — see auto-attestor/policy.ts). Null = no
  // cap configured for this policy version (falls back to the global
  // per-currency AUTO_ATTESTOR_MAX_AMOUNT_ETH/_SOL env caps).
  autoSettlementCapNative Decimal?
  allowedAssets         String[]
  allowedChains         String[]
  kycRequired           Boolean  @default(false)
  // Shape: { maxDisputesPerPartyPerWindow, maxDisputesPerOrgPerWindow,
  //          rollingWindowDays, maxVolumeUsdPerPartyPerWindow }
  // Free-form JSON (not typed columns) since this is exactly the kind
  // of config a customer should be able to tune without a migration —
  // see lib/risk-engine.ts's VelocityLimitsSchema for the validated shape.
  velocityLimits        Json
  // Shape: { highValueUsdThreshold, dualApprovalUsdThreshold }.
  // lowConfidenceThreshold is deliberately NOT a field here — GenLayer's
  // adjudicator.py never populates Decision.confidence today (verified:
  // no writer of that column exists anywhere in this codebase), so a
  // policy-configurable low-confidence route would have nothing real to
  // compare against. See lib/escalation.ts's header comment.
  humanReviewTriggers   Json

  cases Case[]
  partyVerifications PartyVerification[]

  @@unique([policyId, version])
  @@index([policyId])
}

enum RiskAction {
  ALLOW
  REQUIRE_KYC
  REQUIRE_REVIEW
  BLOCK
}

// Phase 4, item 2 — computed once at case creation (fail-closed: a
// caller cannot create a case for which this computation itself
// errors), and re-checked at settlement-dispatch time for velocity
// drift that happened after case creation (e.g. the same claimant filed
// three more disputes elsewhere while this one was being adjudicated).
// One row per case; a settlement-time recheck updates the SAME row
// (recheckedAt/action can change) rather than creating a second one, so
// "what does the risk engine currently say about this case" is always
// a single unambiguous read.
model RiskAssessment {
  id             String     @id @default(cuid())
  case           Case       @relation(fields: [caseId], references: [id])
  caseId         String     @unique
  action         RiskAction
  reasons        String[]
  claimantRecentDisputeCount   Int
  respondentRecentDisputeCount Int
  repeatPairDisputeCount       Int
  orgRollingDisputeCount       Int
  orgRollingVolumeUsd          Decimal
  computedAt     DateTime   @default(now())
  recheckedAt    DateTime?
  recheckAction  RiskAction?
  recheckReasons String[]

  @@index([action])
}

enum ReviewTrigger {
  // Case amount (in USD) meets or exceeds the binding policy version's
  // humanReviewTriggers.highValueUsdThreshold.
  HIGH_VALUE
  // The bound RiskAssessment's action was REQUIRE_REVIEW — folds in
  // both anti-fraud signals and the repeat claimant/respondent-pair
  // dispute pattern (see risk-engine.ts's repeatPairDisputeCount check),
  // which escalates via this same RiskAction rather than a separate
  // enum value, since it's already a REQUIRE_REVIEW-shaped signal.
  FRAUD_RISK
  // A human explicitly requested review through the dashboard, outside
  // any automatic trigger.
  MANUAL
  // Track 5, item 5: a party filed an appeal — see appeal-service.ts's
  // triggerAppeal. Deterministic: an appeal was filed, or it wasn't.
  APPEAL_FILED
  // Track 5, item 5: a party's KYC/sanctions verification came back
  // DECLINED for a case whose bound policy requires it — see
  // settlement-kyc.ts's requireKycApproval / PartyVerificationStatus.
  KYC_SANCTIONS
  // Track 5, item 5: automated settlement dispatch exhausted
  // MAX_RELAY_ATTEMPTS without ever reaching relayTxHash — see
  // adjudication-service.ts's retryFailedSettlements. A human needs to
  // look at why, not an unbounded retry loop.
  SETTLEMENT_FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Phase 4, item 3 — human escalation. One row per case that has ever
// been escalated. requiresDualApproval is set once, at creation, from
// the binding policy version's humanReviewTriggers.dualApprovalUsdThreshold
// compared against the case amount — never recomputed afterward, for
// the same immutability reasoning as the policy binding itself.
model CaseReview {
  id                   String       @id @default(cuid())
  case                 Case         @relation(fields: [caseId], references: [id])
  caseId               String       @unique
  trigger              ReviewTrigger
  status               ReviewStatus @default(PENDING)
  requiresDualApproval Boolean      @default(false)
  createdAt            DateTime     @default(now())
  resolvedAt           DateTime?

  approvals CaseReviewApproval[]
  notes     CaseReviewNote[]

  @@index([status])
}

// One member's approve/reject vote. Unique per (review, member) so the
// same reviewer can't be counted twice toward a dual-approval
// requirement — a real second, independent reviewer is required.
model CaseReviewApproval {
  id        String     @id @default(cuid())
  review    CaseReview @relation(fields: [reviewId], references: [id])
  reviewId  String
  memberId  String
  decision  String // "APPROVE" | "REJECT"
  reason    String?
  createdAt DateTime   @default(now())

  @@unique([reviewId, memberId])
  @@index([reviewId])
}

// Append-only reviewer notes — no update/delete path exists anywhere in
// application code, by design (immutable audit trail of what a human
// reviewer actually observed and said, same discipline as AuditLog).
model CaseReviewNote {
  id        String     @id @default(cuid())
  review    CaseReview @relation(fields: [reviewId], references: [id])
  reviewId  String
  memberId  String
  note      String
  createdAt DateTime   @default(now())

  @@index([reviewId])
}
