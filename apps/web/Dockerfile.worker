# Standalone job worker (src/worker.ts) — built from the repo root so npm
# workspaces resolve (@anchor/hyperlane-relay, @anchor/genlayer-sdk). Runs
# via tsx (no build step needed — worker.ts and its lib/ dependencies are
# plain TS, transpiled on the fly), not the Next.js build, since this
# image never serves HTTP.
#
# Build context MUST be the repo root: docker build -f apps/web/Dockerfile.worker .
FROM node:20-slim

# Prisma's query engine needs a real libssl to detect at startup, or it
# silently falls back to a guessed version and can fail at runtime.
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /repo

# Workspace manifests first for better layer caching.
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/hyperlane-relay/package.json packages/hyperlane-relay/package.json
COPY packages/genlayer-sdk/package.json packages/genlayer-sdk/package.json

RUN npm ci --workspace=@anchor/web --workspace=@anchor/hyperlane-relay --workspace=@anchor/genlayer-sdk --include-workspace-root

# Now the actual source. genlayer/contracts is a runtime read (see
# lib/genlayer.ts's ADJUDICATOR_CONTRACT_PATH) — the contract source is
# uploaded as part of every deploy/appeal call, not just build-time.
COPY packages/hyperlane-relay packages/hyperlane-relay
COPY packages/genlayer-sdk packages/genlayer-sdk
COPY apps/web apps/web
COPY genlayer/contracts genlayer/contracts

WORKDIR /repo/apps/web

RUN npx prisma generate

CMD ["npx", "tsx", "src/worker.ts"]
