# Required, no default on purpose — one of development/staging/production.
# Namespaces the BullMQ queue name and is checked against a guard row in
# this DATABASE_URL's own database (see lib/app-env.ts) so a worker
# process with the wrong APP_ENV can't silently consume a different
# environment's jobs, even if it's accidentally pointed at that
# environment's Redis. Set this explicitly for every deployment —
# local/staging/production must each have their own real value, and it
# must never be copied from another environment's config alongside a
# different DATABASE_URL/REDIS_URL.
APP_ENV="development"

DATABASE_URL="postgresql://anchor:anchor@localhost:5555/anchor"
# Job queue (BullMQ) — see lib/queue.ts's header comment for how to run
# Redis locally. Point this at whatever Redis instance the queue and
# worker(s) should share. Never point a local/test REDIS_URL at a
# staging/production Redis instance, even temporarily for testing — the
# APP_ENV-namespaced queue name means it's technically safe to share the
# same Redis across environments, but DATABASE_URL still needs its own
# real value to match, and mixing them defeats the whole point of the
# guard being there.
REDIS_URL="redis://localhost:6379"

# Signs dashboard session cookies (HMAC) — generate with: openssl rand -hex 32
SESSION_SECRET=""

# Base URL used to build links in outgoing emails (invite/verify/reset) and
# public case pages. Falls back to the request's own origin if unset.
APP_ORIGIN=""

# Brevo (transactional email — invite flow / password reset)
BREVO_API_KEY=""
BREVO_MCP_API_KEY=""
# Must be a sender verified in Brevo's dashboard (Settings -> Senders) —
# Brevo's API accepts (200/201, a real messageId) a send from ANY From
# address, verified or not, so an unverified/fake domain here fails
# silently: the API call looks successful but nothing is ever delivered
# (no SPF/DKIM alignment, dropped or spam-boxed by the recipient's mail
# server). Check `GET https://api.brevo.com/v3/senders` against the real
# account before setting this.
EMAIL_FROM_ADDRESS=""

# Cloudinary (file evidence — images/PDFs/etc). Get these from
# https://console.cloudinary.com -> Dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# GenLayer StudioNet
GENLAYER_STUDIO_URL="https://studio.genlayer.com/api"
GENLAYER_CHAIN_ID="61999"
GENLAYER_PRIVATE_KEY=""
# Address of the deployed Adjudicator contract factory/registry, once we have one.
GENLAYER_REGISTRY_ADDRESS=""

# Hyperlane DecisionRelay auto-dispatch (packages/hyperlane-relay). A
# funded EVM key that pays gas for the dispatch() call on the origin
# chain (sepolia) — see chains/hyperlane-relayer/README.md for the
# matching self-hosted relayer that actually delivers these.
HYPERLANE_RELAY_PRIVATE_KEY=""
HYPERLANE_RELAY_RPC_URL="https://ethereum-sepolia.publicnode.com"

# Deliberately a DIFFERENT key from HYPERLANE_RELAY_PRIVATE_KEY — signs
# the decision-content attestation DecisionRelay.sol's handle() verifies
# via ecrecover (see that contract's `attestor` doc comment). Its public
# address must match whatever DecisionRelay.sol was deployed with as
# `_attestor` (see chains/evm/deploy/DeployDecisionRelay.s.sol's
# ATTESTOR_ADDRESS env var) — a mismatch here means every real decision
# fails on-chain with "invalid attestation". Needs no ETH/gas of its own,
# it never sends a transaction, only signs a hash locally.
ATTESTOR_PRIVATE_KEY=""

# External audit-chain anchoring (lib/audit-anchor.ts) — periodically
# posts each organization's audit-log chain head to a small Sepolia
# contract (chains/evm/contracts/AuditAnchor.sol) so history can't be
# silently rewritten in the database alone. Reuses
# HYPERLANE_RELAY_PRIVATE_KEY/HYPERLANE_RELAY_RPC_URL above to sign/send
# the anchor() transaction — see that file's own SCOPE NOTE on what this
# does and doesn't defend against. Leaving this unset just skips the
# sweep (logged, not fatal) rather than crashing the worker.
AUDIT_ANCHOR_CONTRACT_ADDRESS=""

# Solana settlement (lib/solana-settle.ts) — decision-relay's Solana
# recipient no longer settles from Hyperlane delivery alone (see that
# program's `attested_settle` doc comment); Anchor's backend submits a
# real Solana transaction directly, containing a real Ed25519 signature
# verification instruction. Both key values are JSON arrays of a 64-byte
# secret key, solana-keygen's own on-disk keypair format (e.g. the exact
# contents of a keypair.json file) — NOT base58, NOT hex.
SOLANA_RPC_URL="https://api.testnet.solana.com"
# Solana-native Ed25519 attestor key — DIFFERENT from ATTESTOR_PRIVATE_KEY
# above (that one is secp256k1/EVM-native; Solana verifies Ed25519, EVM
# verifies secp256k1 via ecrecover — there is no single key usable on
# both chains). Its public key must match ATTESTOR_PUBKEY hardcoded in
# chains/solana/programs/decision-relay/src/lib.rs.
SOLANA_ATTESTOR_PRIVATE_KEY=""
# Pays transaction fees for the AttestedSettle submission. Needs a small
# amount of real (testnet) SOL.
SOLANA_RELAY_PRIVATE_KEY=""
