# Required, no default on purpose — one of development/staging/production.
# Namespaces the BullMQ queue name and is checked against a guard row in
# this DATABASE_URL's own database (see lib/app-env.ts) so a worker
# process with the wrong APP_ENV can't silently consume a different
# environment's jobs, even if it's accidentally pointed at that
# environment's Redis. Set this explicitly for every deployment —
# local/staging/production must each have their own real value, and it
# must never be copied from another environment's config alongside a
# different DATABASE_URL/REDIS_URL.
APP_ENV="development"

DATABASE_URL="postgresql://anchor:anchor@localhost:5555/anchor"
# Job queue (BullMQ) — see lib/queue.ts's header comment for how to run
# Redis locally. Point this at whatever Redis instance the queue and
# worker(s) should share. Never point a local/test REDIS_URL at a
# staging/production Redis instance, even temporarily for testing — the
# APP_ENV-namespaced queue name means it's technically safe to share the
# same Redis across environments, but DATABASE_URL still needs its own
# real value to match, and mixing them defeats the whole point of the
# guard being there.
REDIS_URL="redis://localhost:6379"

# Signs dashboard session cookies (HMAC) — generate with: openssl rand -hex 32
SESSION_SECRET=""

# Encrypts webhook signing secrets at rest (AES-256-GCM) — generate with:
# openssl rand -hex 32. Must be exactly 32 bytes (64 hex chars). Losing
# this key makes existing webhook secrets undecryptable (existing
# webhooks would need their secret rotated via POST
# /api/webhooks/:id/rotate-secret); rotating it invalidates every
# previously-encrypted secret the same way.
WEBHOOK_SECRET_ENCRYPTION_KEY=""

# Base URL used to build links in outgoing emails (invite/verify/reset) and
# public case pages. Falls back to the request's own origin ONLY when
# APP_ENV=development — required (throws at request time otherwise) in
# staging/production, so a spoofed/forwarded Host header can never be
# used to make Anchor generate a real verification/reset/invite link
# pointing at an attacker-controlled domain. See lib/app-env.ts's
# secureAppOrigin.
APP_ORIGIN=""

# Brevo (transactional email — invite flow / password reset)
BREVO_API_KEY=""
BREVO_MCP_API_KEY=""
# Must be a sender verified in Brevo's dashboard (Settings -> Senders) —
# Brevo's API accepts (200/201, a real messageId) a send from ANY From
# address, verified or not, so an unverified/fake domain here fails
# silently: the API call looks successful but nothing is ever delivered
# (no SPF/DKIM alignment, dropped or spam-boxed by the recipient's mail
# server). Check `GET https://api.brevo.com/v3/senders` against the real
# account before setting this.
EMAIL_FROM_ADDRESS=""

# Cloudinary (file evidence — images/PDFs/etc). Get these from
# https://console.cloudinary.com -> Dashboard.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Didit (KYC/KYB/sanctions-screening) — https://docs.didit.me/. Free
# tier: 500 verifications/month, forever. Used for party identity/
# business verification and sanctions/PEP/adverse-media screening —
# not yet wired into any route as of this addition; the integration
# layer (DB model for verification status, webhook receiver, gating
# hooks) is a real, separate next step.
DIDIT_API_KEY=""
# Workflow "Anchor Party KYC" — ID Verification + Liveness + Face Match
# (all within the free 500/mo tier; AML/sanctions screening left off,
# it's a paid add-on, not enabled without an explicit decision to pay
# per check). Not a secret, but kept here rather than hardcoded so a
# workflow change doesn't need a code deploy.
DIDIT_WORKFLOW_ID="30453635-641a-4477-9ce1-9954e87cf347"
# HMAC secret for verifying X-Signature-V2 on inbound webhooks from the
# "Anchor production" destination (https://anc-hor.vercel.app/api/webhooks/didit,
# subscribed to status.updated) — see Didit's docs for the exact
# canonical-JSON HMAC-SHA256 verification algorithm this must replicate
# byte-for-byte.
DIDIT_WEBHOOK_SECRET=""

# GenLayer StudioNet
GENLAYER_STUDIO_URL="https://studio.genlayer.com/api"
GENLAYER_CHAIN_ID="61999"
GENLAYER_PRIVATE_KEY=""
# Address of the deployed Adjudicator contract factory/registry, once we have one.
GENLAYER_REGISTRY_ADDRESS=""

# Hyperlane DecisionRelay auto-dispatch (packages/hyperlane-relay). A
# funded EVM key that pays gas for the dispatch() call on the origin
# chain (sepolia) — see chains/hyperlane-relayer/README.md for the
# matching self-hosted relayer that actually delivers these.
HYPERLANE_RELAY_PRIVATE_KEY=""
HYPERLANE_RELAY_RPC_URL="https://ethereum-sepolia.publicnode.com"

# M-of-N: comma-separated list of attestor private keys THIS PROCESS
# holds — deliberately DIFFERENT keys from HYPERLANE_RELAY_PRIVATE_KEY
# above. Each signs the decision-content attestation DecisionRelay.sol's
# handle() verifies via ecrecover (see that contract's
# `isAttestor`/`attestorThreshold` doc comment). Every public address
# derived from these must be a registered attestor on the deployed
# DecisionRelay (see chains/evm/deploy/DeployDecisionRelay.s.sol's
# ATTESTOR_ADDRESSES/ATTESTOR_THRESHOLD env vars) — an unregistered
# address here just contributes a signature that's silently ignored, not
# an error, so a real misconfiguration shows up as "insufficient valid
# attestations" instead of a clear mismatch. None of these need ETH/gas,
# they never send a transaction, only sign a hash locally.
#
# SECURITY: for M-of-N to mean anything, this backend process should NOT
# hold attestorThreshold-many (or more) of these keys itself — that's a
# single point of compromise again, just relabeled. See
# docs/multisig-attestor-setup.md for how to actually split custody
# across separate holders and collect the remaining signature(s)
# out-of-band before dispatch.
ATTESTOR_PRIVATE_KEYS=""
# Old single-key fallback — still read if ATTESTOR_PRIVATE_KEYS is unset,
# for a deployment that hasn't rotated to the multisig contract yet.
ATTESTOR_PRIVATE_KEY=""

# External audit-chain anchoring (lib/audit-anchor.ts) — periodically
# posts each organization's audit-log chain head to a small Sepolia
# contract (chains/evm/contracts/AuditAnchor.sol) so history can't be
# silently rewritten in the database alone. Uses
# HYPERLANE_RELAY_RPC_URL above (RPC only, not the key) plus
# AUDIT_ANCHOR_PRIVATE_KEY below to sign/send the anchor() transaction —
# see that file's own SCOPE NOTE on what this does and doesn't defend
# against. Leaving this unset just skips the sweep (logged, not fatal)
# rather than crashing the worker.
AUDIT_ANCHOR_CONTRACT_ADDRESS=""
# A key DEDICATED to anchoring — deliberately different from
# HYPERLANE_RELAY_PRIVATE_KEY/ATTESTOR_PRIVATE_KEYS, so a compromise of
# the dispatch/attestor keys doesn't also let an attacker silently
# rewrite the external checkpoint meant to catch tampering. Needs a
# small amount of real Sepolia ETH for gas; falls back to
# HYPERLANE_RELAY_PRIVATE_KEY if unset (old behavior, kept so upgrading
# doesn't silently stop anchoring).
AUDIT_ANCHOR_PRIVATE_KEY=""

# Bearer secret protecting POST/GET /api/internal/pending-attestations —
# lets an external M-of-N attestor holder (see
# docs/multisig-attestor-setup.md) submit a co-signature for a decision
# the backend's own ATTESTOR_PRIVATE_KEYS alone can't reach threshold
# on. Generate with: openssl rand -hex 32. This gates WHO can attempt to
# submit a signature, not whether it's valid — a submitted signature
# that doesn't recover to a registered attestor address is still
# rejected regardless of this secret (see that route's own comment).
ATTESTOR_COSIGN_SECRET=""

# Solana settlement (lib/solana-settle.ts) — decision-relay's Solana
# recipient no longer settles from Hyperlane delivery alone (see that
# program's `attested_settle` doc comment); Anchor's backend submits a
# real Solana transaction directly, containing M-of-N real Ed25519
# signature verification instructions (currently 2-of-2). Both key
# values are JSON arrays of a 64-byte secret key, solana-keygen's own
# on-disk keypair format (e.g. the exact contents of a keypair.json
# file) — NOT base58, NOT hex.
SOLANA_RPC_URL="https://api.testnet.solana.com"
# Solana-native Ed25519 attestor key THIS BACKEND holds — DIFFERENT from
# ATTESTOR_PRIVATE_KEYS above (that's secp256k1/EVM-native; Solana
# verifies Ed25519, EVM verifies secp256k1 via ecrecover — there is no
# single key usable on both chains). Its public key must be one of the
# ATTESTOR_PUBKEYS hardcoded in
# chains/solana/programs/decision-relay/src/lib.rs. The backend
# deliberately holds only ONE of the ATTESTOR_THRESHOLD-many keys
# required (see docs/multisig-attestor-setup.md's Solana section) — the
# rest must be supplied externally at dispatch time (see
# submitAttestedSettle's externalAttestations parameter).
SOLANA_ATTESTOR_PRIVATE_KEY=""
# Pays transaction fees for the AttestedSettle submission, and for any
# SOLANA_DECISION_RELAY_LOOKUP_TABLE extension this backend triggers.
# Needs a small amount of real (testnet) SOL.
SOLANA_RELAY_PRIVATE_KEY=""
# An Address Lookup Table (base58) pre-populated with decision-relay's
# static accounts (Sysvar1nstructions, the Ed25519 native program, the
# escrow program, decision-relay's own program id, and its two PDAs).
# Required once ATTESTOR_THRESHOLD > 1: 2+ Ed25519 verify instructions
# in one transaction (each embeds the full attestation message inline —
# unavoidable duplication) push a legacy transaction over Solana's
# 1232-byte limit for any realistic case_id. solana-settle.ts also
# auto-extends this same table with a decision's specific
# claimant/respondent addresses the first time each is seen (a small
# extra transaction + ~1 slot of latency, only once per address). Optional
# for a 1-of-1 deployment or very short case_ids; effectively required
# for the current 2-of-2 deployment. See docs/multisig-attestor-setup.md.
SOLANA_DECISION_RELAY_LOOKUP_TABLE=""
